@model UsersPageViewModel
@{
    ViewData["Title"] = "Usuários";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Perfis</p>
        <h2>Usuários e anotações</h2>
        <p class="text-secondary">Admin, Ghost, Especial e Comum com regras específicas de tempo, saldo e anotação.</p>
    </div>
    <div class="button-row">
        <a href="/ajuda#help-usuarios" class="btn btn-outline-light" title="Explica perfis, login, PIN, saldo e anotações.">Ajuda sobre usuários</a>
    </div>
</section>

<section class="two-column">
    <article class="panel">
        <h3>Salvar usuário</h3>
        <form asp-action="Save" method="post" class="form-grid compact-grid">
            @Html.AntiForgeryToken()
            <input asp-for="Form.Id" type="hidden" />
            <div>
            <label asp-for="Form.DisplayName" class="form-label" title="Nome que aparecerá no atendimento e nos relatórios.">Nome</label>
            <input asp-for="Form.DisplayName" class="form-control" maxlength="100" required title="Nome visível do usuário." />
            </div>
            <div>
            <label asp-for="Form.Login" class="form-label" title="Identificador usado pelo usuário para entrar no Client.">Login</label>
            <input asp-for="Form.Login" class="form-control" maxlength="64" autocomplete="off" required title="Use letras e, opcionalmente, números, ponto, hífen ou sublinhado; não use espaços." />
                <div class="form-hint">Use letras e, se quiser, números, ponto, hífen ou sublinhado. Não use espaços.</div>
            </div>
            <div>
            <label asp-for="Form.Pin" class="form-label" title="Código numérico de 4 dígitos usado no acesso do usuário.">PIN</label>
            <input asp-for="Form.Pin" type="password" class="form-control" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="new-password" title="Informe exatamente 4 números. Ao editar, vazio mantém o PIN atual." />
                <div class="form-hint">Quatro dígitos. Ao editar, deixe vazio para manter o PIN atual.</div>
            </div>
            <div>
            <label asp-for="Form.Password" class="form-label" title="Senha usada somente quando o perfil tiver acesso ao painel.">Senha do painel</label>
            <input asp-for="Form.Password" type="password" class="form-control" minlength="12" maxlength="256" autocomplete="new-password" title="Senha para acesso ao painel; use pelo menos 12 caracteres." />
                <div class="form-hint">Necessária apenas para perfis com acesso ao painel.</div>
            </div>
            <div>
            <label asp-for="Form.ProfileType" class="form-label" title="Define as permissões e regras de uso desta conta.">Perfil</label>
            <select asp-for="Form.ProfileType" class="form-select" asp-items="Html.GetEnumSelectList<UserProfileType>()" title="Perfil e permissões do usuário."></select>
            </div>
            <div>
            <label asp-for="Form.Balance" class="form-label" title="Crédito disponível para descontar das sessões.">Saldo</label>
            <input asp-for="Form.Balance" class="form-control" title="Saldo atual do usuário." />
            </div>
            <div>
            <label asp-for="Form.AnnotationLimit" class="form-label" title="Valor máximo que pode ficar pendente para este usuário.">Limite de anotação</label>
            <input asp-for="Form.AnnotationLimit" class="form-control" title="Limite financeiro de anotação pendente." />
            </div>
            <div class="form-check align-self-end">
                <input asp-for="Form.IsTemporary" class="form-check-input" />
            <label asp-for="Form.IsTemporary" class="form-check-label" title="Faz a conta expirar na data informada.">Conta temporária</label>
            </div>
            <div>
            <label asp-for="Form.TemporaryUntilUtc" class="form-label" title="Data e hora de expiração quando a conta temporária estiver marcada.">Válida até</label>
            <input asp-for="Form.TemporaryUntilUtc" type="datetime-local" class="form-control" title="Data e hora em que a conta deixará de funcionar." />
            </div>
            <div class="form-check align-self-end">
                <input asp-for="Form.IsBlocked" class="form-check-input" />
            <label asp-for="Form.IsBlocked" class="form-check-label" title="Impede o acesso do usuário sem apagar seu histórico.">Conta bloqueada</label>
            </div>
            <div class="full-span">
            <label asp-for="Form.Notes" class="form-label" title="Anotações internas para a equipe.">Observações</label>
            <textarea asp-for="Form.Notes" class="form-control" rows="3" maxlength="1000" title="Anotações internas que não alteram o login."></textarea>
            </div>
            <button type="submit" class="btn btn-accent" title="Cria o usuário ou salva as alterações do usuário selecionado.">Salvar usuário</button>
        </form>
    </article>
    <article class="panel">
        <h3>Lançamento financeiro</h3>
        <form asp-action="Ledger" method="post" class="form-grid compact-grid">
            @Html.AntiForgeryToken()
            <div>
                <label asp-for="LedgerForm.UserAccountId" class="form-label" title="Usuário que receberá este lançamento financeiro.">Usuário</label>
                <select asp-for="LedgerForm.UserAccountId" class="form-select" title="Escolha o usuário do lançamento.">
                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id">@user.DisplayName (@user.ProfileType)</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="LedgerForm.Type" class="form-label" title="Define se o valor entra como crédito ou saída.">Tipo</label>
                <select asp-for="LedgerForm.Type" class="form-select" asp-items="Html.GetEnumSelectList<LedgerEntryType>()" title="Tipo do movimento financeiro."></select>
            </div>
            <div>
                <label asp-for="LedgerForm.Amount" class="form-label" title="Valor em reais do lançamento.">Valor</label>
                <input asp-for="LedgerForm.Amount" class="form-control" title="Valor financeiro do lançamento." />
            </div>
            <div class="full-span">
                <label asp-for="LedgerForm.Description" class="form-label" title="Motivo ou detalhes para consultar depois no histórico.">Descrição</label>
                <textarea asp-for="LedgerForm.Description" class="form-control" rows="3" title="Descrição interna do lançamento."></textarea>
            </div>
            <button type="submit" class="btn btn-accent" title="Registra uma entrada ou saída no histórico financeiro do usuário.">Registrar</button>
        </form>
    </article>
</section>

<section class="panel">
    <h3>Base de usuários</h3>
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Login</th>
                    <th>Perfil</th>
                    <th>Saldo</th>
                    <th>Anotado</th>
                    <th>Limite</th>
                    <th>Temporário</th>
                    <th>Bloqueado</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>
                            <strong>@user.DisplayName</strong>
                            @if (!string.IsNullOrWhiteSpace(user.Notes))
                            {
                                <div class="small text-secondary">@user.Notes</div>
                            }
                        </td>
                        <td>@user.Login</td>
                        <td>@user.ProfileType</td>
                        <td>R$ @user.Balance.ToString("N2")</td>
                        <td>R$ @user.PendingAnnotationAmount.ToString("N2")</td>
                        <td>@(user.ProfileType == UserProfileType.Common ? $"R$ {user.AnnotationLimit:N2}" : "Ilimitado")</td>
                        <td>@(user.IsTemporary ? "Sim" : "Não")</td>
                        <td>@(user.IsBlocked ? "Sim" : "Não")</td>
                        <td><a asp-action="Index" asp-route-editId="@user.Id" class="btn btn-outline-light btn-sm" title="Carrega este usuário no formulário para edição.">Editar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
