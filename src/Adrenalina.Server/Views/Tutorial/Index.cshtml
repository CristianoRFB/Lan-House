@model HelpPageViewModel
@{
    ViewData["Title"] = "Ajuda";
    var visibleChecklist = Model.Checklist.Where(item => !item.AdminOnly || User.IsInRole("Admin")).ToArray();
}

<div class="help-page" data-help-page data-help-version="@Model.Version">
    <section class="page-header">
        <div>
            <p class="eyebrow">Autoatendimento do ADMIN</p>
            <h2>Central de ajuda</h2>
            <p class="text-secondary">Orientações curtas para configurar, operar e resolver problemas no Adrenalina.</p>
        </div>
        <div class="button-row">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light">Voltar ao painel</a>
            <button type="button" class="btn btn-accent" data-help-restart>Refazer guia</button>
        </div>
    </section>

    <section class="help-welcome panel" data-help-welcome hidden>
        <div>
            <p class="eyebrow mb-2">Primeiro acesso</p>
            <h3>Bem-vindo ao painel do Adrenalina</h3>
            <p class="text-secondary mb-0">Aqui você acompanha máquinas, sessões, usuários, solicitações, relatórios e configurações em um único lugar.</p>
        </div>
        <div class="button-row">
            <button type="button" class="btn btn-accent" data-help-start>Começar guia</button>
            <button type="button" class="btn btn-outline-light" data-help-explore>Explorar sozinho</button>
        </div>
    </section>

    <section class="help-toolbar panel" aria-label="Buscar ajuda">
        <div class="help-search-field">
            <label for="help-search" class="form-label">Como podemos ajudar?</label>
            <input id="help-search" class="form-control" type="search" placeholder="Buscar por máquina, sessão, senha..." autocomplete="off" data-help-search />
        </div>
        <div>
            <span class="form-label d-block">Categorias</span>
            <div class="help-category-list" role="group" aria-label="Filtrar categorias">
                <button type="button" class="btn btn-sm btn-category active" data-help-category="*">Tudo</button>
                @foreach (var category in Model.Categories)
                {
                    <button type="button" class="btn btn-sm btn-category" data-help-category="@category">@category</button>
                }
            </div>
        </div>
        <p class="help-search-status text-secondary mb-0" data-help-search-status aria-live="polite"></p>
    </section>

    <section class="help-checklist panel" data-help-checklist>
        <div class="help-section-heading">
            <div>
                <p class="eyebrow mb-2">Roteiro de implantação</p>
                <h3>Vamos configurar sua operação</h3>
                <p class="text-secondary mb-0">Marque cada etapa quando ela estiver pronta. O progresso fica salvo neste navegador.</p>
            </div>
            <strong class="help-progress-label" data-help-progress>0 de @visibleChecklist.Length concluídos</strong>
        </div>
        <div class="progress help-progress" role="progressbar" aria-label="Progresso da configuração" aria-valuemin="0" aria-valuemax="@visibleChecklist.Length" aria-valuenow="0">
            <div class="progress-bar" data-help-progress-bar style="width: 0%"></div>
        </div>
        <div class="help-checklist-grid">
            @foreach (var item in visibleChecklist)
            {
                <label class="help-check-item">
                    <input type="checkbox" value="@item.Id" data-help-check />
                    <span>
                        <strong>@item.Label</strong>
                        <a href="#help-@item.ArticleId" data-help-related="@item.ArticleId">Ver orientação</a>
                    </span>
                </label>
            }
        </div>
    </section>

    <section class="help-articles" aria-labelledby="help-articles-title">
        <div class="help-section-heading">
            <div>
                <p class="eyebrow mb-2">Dúvidas frequentes</p>
                <h3 id="help-articles-title">Orientações do sistema</h3>
            </div>
            <span class="text-secondary">@Model.Articles.Count artigos disponíveis para seu perfil</span>
        </div>
        <div class="help-article-grid">
            @foreach (var article in Model.Articles)
            {
                var searchText = string.Join(" ", new[] { article.Title, article.Summary }.Concat(article.Steps).Concat(article.Keywords));
                <article id="help-@article.Id" class="panel help-article" data-help-article data-help-id="@article.Id" data-help-category-value="@article.Category" data-help-search-text="@searchText">
                    <div class="help-article-heading">
                        <span class="status-pill">@article.Category</span>
                        <h4>@article.Title</h4>
                    </div>
                    <p class="text-secondary">@article.Summary</p>
                    <details>
                        <summary>Ver passo a passo</summary>
                        <ol class="tutorial-list">
                            @foreach (var step in article.Steps)
                            {
                                <li>@step</li>
                            }
                        </ol>
                    </details>
                    @if (article.Related.Count > 0)
                    {
                        <div class="help-related">
                            <span class="small text-secondary">Talvez você também queira saber</span>
                            <div class="mini-inline">
                                @foreach (var relatedId in article.Related)
                                {
                                    var related = Model.Articles.FirstOrDefault(candidate => candidate.Id == relatedId);
                                    if (related is not null)
                                    {
                                        <a href="#help-@related.Id" data-help-related="@related.Id">@related.Title</a>
                                    }
                                }
                            </div>
                        </div>
                    }
                    <div class="help-feedback" data-help-feedback>
                        <span class="small text-secondary">Isso respondeu sua dúvida?</span>
                        <button type="button" class="btn btn-sm btn-outline-success" data-help-feedback-action="yes">Sim</button>
                        <button type="button" class="btn btn-sm btn-outline-light" data-help-feedback-action="no">Ainda não</button>
                    </div>
                </article>
            }
        </div>
        <div class="help-empty panel" data-help-empty hidden>
            <h4>Não encontramos uma resposta para sua busca.</h4>
            <p class="text-secondary">Tente outras palavras, consulte todas as categorias ou fale com o responsável pelo ADMIN.</p>
            <button type="button" class="btn btn-outline-light" data-help-clear>Limpar busca</button>
        </div>
    </section>
</div>
