@model ChangeAdminPasswordViewModel
@{
    ViewData["Title"] = "Trocar senha";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Segurança local</p>
        <h2>Trocar senha do administrador</h2>
        <p class="text-secondary">Defina uma nova senha para o login <code>admin</code> sem procurar o usuário na lista.</p>
    </div>
</section>

<section class="panel narrow-panel">
    <form asp-controller="Auth" asp-action="ChangePassword" method="post" class="form-grid">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div>
            <label asp-for="NewPassword" class="form-label">Nova senha</label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
            <div class="form-hint">Use pelo menos 12 caracteres.</div>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <div>
            <label asp-for="ConfirmPassword" class="form-label">Confirmar nova senha</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <div class="button-row">
            <button type="submit" class="btn btn-accent">Salvar nova senha</button>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light">Cancelar</a>
        </div>
    </form>
</section>
