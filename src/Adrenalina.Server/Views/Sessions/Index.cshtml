@model SessionsPageViewModel
@{
    ViewData["Title"] = "Sessões";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Tempo e uso</p>
        <h2>Sessões de PCs e consoles</h2>
        <p class="text-secondary">Inicie, acompanhe e encerre o tempo de uso de PCs e consoles.</p>
    </div>
    <div class="button-row">
        <a href="/ajuda#help-sessoes" class="btn btn-outline-light" title="Explica como iniciar, ajustar e encerrar sessões.">Ajuda sobre sessões</a>
    </div>
</section>

<section class="panel">
    <h3>Iniciar sessão</h3>
    <form asp-action="Start" method="post" class="form-grid compact-grid">
        @Html.AntiForgeryToken()
        <div>
            <label asp-for="StartForm.MachineId" class="form-label" title="Escolha a estação que receberá a sessão.">Máquina</label>
            <select asp-for="StartForm.MachineId" class="form-select" title="Máquina que será liberada para uso.">
                @foreach (var machine in Model.Machines)
                {
                    <option value="@machine.Id">@machine.Name (@machine.Kind)</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="StartForm.UserAccountId" class="form-label" title="Vincula a sessão a um usuário cadastrado; uso livre não exige conta.">Usuário</label>
            <select asp-for="StartForm.UserAccountId" class="form-select" title="Usuário responsável pela sessão ou Uso livre / Ghost.">
                <option value="">Uso livre / Ghost</option>
                @foreach (var user in Model.Users)
                {
                    <option value="@user.Id">@user.DisplayName (@user.ProfileType)</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="StartForm.UserDisplayName" class="form-label" title="Nome exibido para um atendimento sem conta cadastrada.">Nome livre</label>
            <input asp-for="StartForm.UserDisplayName" class="form-control" title="Nome opcional para uso livre." />
        </div>
        <div>
            <label asp-for="StartForm.GrantedMinutes" class="form-label" title="Tempo inicial concedido para a sessão.">Minutos</label>
            <input asp-for="StartForm.GrantedMinutes" class="form-control" title="Quantidade de minutos liberados." />
        </div>
        <div>
            <label asp-for="StartForm.HourlyRate" class="form-label" title="Preço por hora usado no cálculo desta sessão.">Valor/hora</label>
            <input asp-for="StartForm.HourlyRate" class="form-control" title="Preço por hora da sessão." />
        </div>
        <div class="form-check align-self-end">
            <input asp-for="StartForm.IsDemoMode" class="form-check-input" />
            <label asp-for="StartForm.IsDemoMode" class="form-check-label" title="Cria uma sessão de demonstração sem lançar cobrança.">Não contabilizar cobrança</label>
        </div>
        <div class="form-check align-self-end">
            <input asp-for="StartForm.HideTimerOnClient" class="form-check-input" />
            <label asp-for="StartForm.HideTimerOnClient" class="form-check-label" title="Esconde o tempo restante na tela do Client, sem parar a sessão.">Ocultar cronômetro</label>
        </div>
        <button class="btn btn-accent" title="Libera a máquina e começa a contar o tempo da sessão.">Iniciar sessão</button>
    </form>
</section>

<section class="panel">
    <h3>Sessões recentes</h3>
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Máquina</th>
                    <th>Usuário</th>
                    <th>Tipo</th>
                    <th>Status</th>
                    <th>Tempo</th>
                    <th>Valor</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in Model.Sessions)
                {
                    <tr>
                        <td>@session.MachineName</td>
                        <td>@session.UserDisplayName (@session.UserProfileType)</td>
                        <td>@session.MachineKind</td>
                        <td>@session.Status</td>
                        <td>@session.ConsumedMinutes min / resta @session.RemainingMinutes</td>
                        <td>R$ @session.TotalSpent.ToString("N2")</td>
                        <td>
                            @if (session.Status == SessionStatus.Active)
                            {
                                <div class="action-stack">
                                    <form asp-action="Adjust" method="post" class="mini-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="SessionId" value="@session.Id" />
                                        <input type="number" name="AdditionalMinutes" class="form-control form-control-sm" placeholder="+min" title="Minutos adicionais, se necessário." />
                                        <input type="number" name="AdditionalAnnotationAmount" step="0.01" class="form-control form-control-sm" placeholder="+anotação" title="Valor adicional de anotação, se houver." />
                                        <input type="text" name="Reason" class="form-control form-control-sm" placeholder="Motivo" title="Explique por que o tempo ou valor foi ajustado." />
                                        <button class="btn btn-sm btn-outline-light" title="Aplica os minutos ou valores adicionais à sessão.">Ajustar</button>
                                    </form>
                                    <form asp-action="End" method="post" data-confirm="Encerrar esta sessão agora?">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@session.Id" />
                                        <input type="hidden" name="reason" value="Encerrada pelo administrador." />
                                        <button class="btn btn-sm btn-outline-warning" title="Encerra a sessão e registra o motivo.">Encerrar</button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
