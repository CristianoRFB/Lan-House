@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string NavClass(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Adrenalina</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Adrenalina.Server.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <a class="skip-link" href="#conteudo-principal">Ir para o conteúdo</a>
    <div class="app-shell">
        <aside class="app-sidebar">
            <div>
                <p class="eyebrow">Controle central</p>
                <h1>Adrenalina</h1>
                <p class="sidebar-copy">Operação local de máquinas, clientes, sessões, financeiro e auditoria.</p>
            </div>
            <nav class="nav-stack" aria-label="Navegação principal">
                <a class="@NavClass("Dashboard")" asp-controller="Dashboard" asp-action="Index" title="Resumo da operação, máquinas online, sessões e solicitações.">Painel</a>
                <a class="@NavClass("Machines")" asp-controller="Machines" asp-action="Index" title="Cadastre, pareie, monitore e controle as máquinas.">Máquinas</a>
                <a class="@NavClass("Sessions")" asp-controller="Sessions" asp-action="Index" title="Inicie, ajuste e encerre sessões de uso.">Sessões</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="@NavClass("Users")" asp-controller="Users" asp-action="Index" title="Cadastre usuários, PINs, perfis, saldo e anotações.">Usuários</a>
                    <a class="@NavClass("Auth")" asp-controller="Auth" asp-action="ChangePassword" title="Troque a senha do administrador.">Trocar senha</a>
                    <a class="@NavClass("Reports")" asp-controller="Reports" asp-action="Index" title="Exporte relatórios e consulte a auditoria.">Relatórios</a>
                    <a class="@NavClass("Settings")" asp-controller="Settings" asp-action="Index" title="Ajuste nome, preços, mensagens e backups.">Configurações</a>
                }
                <a class="@NavClass("Tutorial")" asp-controller="Tutorial" asp-action="Index" title="Explicações passo a passo sobre todas as áreas do sistema.">Ajuda</a>
            </nav>
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-light w-100" title="Encerra sua sessão no painel.">Sair</button>
            </form>
        </aside>
        <main class="app-main" id="conteudo-principal" tabindex="-1">
            @if (TempData["StatusMessage"] is string message && !string.IsNullOrWhiteSpace(message))
            {
                <div class="status-banner" role="status">@message</div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
