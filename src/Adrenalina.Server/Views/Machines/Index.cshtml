@model MachinesPageViewModel
@{
    ViewData["Title"] = "Máquinas";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Operação</p>
        <h2>Máquinas</h2>
        <p class="text-secondary">Cadastro e monitoramento seguro de PCs e consoles.</p>
    </div>
    <div class="button-row">
        <a href="/ajuda#help-maquinas" class="btn btn-outline-light" title="Explica o cadastro, a chave, o pareamento e o acompanhamento das máquinas.">Ajuda sobre máquinas</a>
    </div>
</section>

@if (Model.Pairing is not null)
{
    <section class="panel mb-4" aria-live="polite">
        <p class="eyebrow">Pareamento seguro</p>
        <h3 title="Este é o código que deve ser digitado no campo Código do ADMIN, dentro do CLIENTE.">INICIAR CONFIGURAÇÃO · @Model.Pairing.MachineName</h3>
        <p>Use este código temporário no Client. Ele expira em @Model.Pairing.ExpiresAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss").</p>
        @if (Model.Pairing.Status == "WAITING")
        {
            <p class="status-pill">Aguardando estação</p>
        }
        else if (Model.Pairing.Status == "REQUESTED")
        {
            <p class="status-pill">Solicitação recebida: @Model.Pairing.Hostname</p>
            <form asp-action="ApprovePairing" method="post" class="button-row">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pairingId" value="@Model.Pairing.Id" />
                <button type="submit" class="btn btn-accent">Aprovar pareamento</button>
            </form>
        }
        else
        {
            <p class="status-pill">Estado: @Model.Pairing.Status</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Pairing.Code))
        {
            <div class="display-4 letter-spacing-wide" aria-label="código de pareamento" title="Copie estes 6 números para o campo Código do ADMIN no CLIENTE.">@Model.Pairing.Code</div>
        }
    </section>
}

<section class="panel mb-4">
    <h3 title="Cadastre uma estação uma vez. Para alterar uma existente, clique em Editar no cartão da máquina.">Cadastrar ou editar máquina</h3>
    <form asp-action="Save" method="post" class="form-grid compact-grid">
        @Html.AntiForgeryToken()
        <input asp-for="Form.Id" type="hidden" />
        <div>
            <label asp-for="Form.Name" class="form-label" title="Nome amigável para você identificar esta máquina, por exemplo PC-01.">Nome</label>
            <input asp-for="Form.Name" class="form-control" placeholder="PC-01" maxlength="100" required title="Nome amigável da máquina. Exemplo: PC-01." />
        </div>
        <div>
            <label asp-for="Form.MachineKey" class="form-label" title="Identificador secreto e único da máquina. Não é o código de 6 dígitos do pareamento.">Chave</label>
            <input asp-for="Form.MachineKey" class="form-control" placeholder="pc-01-chave-segura" minlength="16" maxlength="100" required autocomplete="off" title="Use uma chave exclusiva de 16 a 100 caracteres, como pc-01-chave-segura." />
            <div class="form-hint">Use uma chave exclusiva de 16 a 100 caracteres. Exemplo: <code>pc-01-chave-segura</code>. O código de 6 dígitos do pareamento é gerado depois.</div>
        </div>
        <div>
            <label asp-for="Form.Kind" class="form-label" title="Informe se a estação é um computador ou console.">Tipo</label>
            <select asp-for="Form.Kind" class="form-select" asp-items="Html.GetEnumSelectList<MachineKind>()" title="Tipo de estação controlada."></select>
        </div>
        <div>
            <label asp-for="Form.GroupName" class="form-label" title="Agrupa máquinas para facilitar a organização, por exemplo Principal ou VIP.">Grupo</label>
            <input asp-for="Form.GroupName" class="form-control" title="Grupo organizacional da máquina. Exemplo: Principal." />
        </div>
        <div class="full-span">
            <label asp-for="Form.Observations" class="form-label" title="Anotações internas sobre a estação; não alteram a conexão.">Observações</label>
            <textarea asp-for="Form.Observations" class="form-control" rows="2" title="Anotações internas, como localização ou manutenção."></textarea>
        </div>
        <button type="submit" class="btn btn-accent" title="Cadastra uma máquina nova ou salva as alterações da máquina selecionada.">Salvar máquina</button>
    </form>
</section>

<section class="machine-grid">
    @if (!Model.Machines.Any())
    {
        <div class="panel empty-state">
            <h3>Nenhuma máquina cadastrada</h3>
            <p>Cadastre a primeira máquina acima e use a mesma chave ao preparar o Client.</p>
        </div>
    }
    @foreach (var machine in Model.Machines)
    {
        <article class="panel machine-card">
            <div class="machine-head">
                <div>
                    <h3>@machine.Name</h3>
                    <p>@machine.Kind · @machine.Hostname · @machine.IpAddress</p>
                </div>
                <span class="status-pill">@machine.Status</span>
            </div>
            <p class="small text-secondary">@machine.Observations</p>
            <p class="small">Chave do cliente: <code aria-label="chave protegida">************</code></p>
            <p class="small">Último contato: @(machine.LastSeenUtc.HasValue ? machine.LastSeenUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") : "ainda não conectado")</p>
            <p class="small">Client: @(string.IsNullOrWhiteSpace(machine.ClientVersion) ? "não informado" : machine.ClientVersion) · Agent: @(string.IsNullOrWhiteSpace(machine.AgentVersion) ? "não informado" : machine.AgentVersion)</p>
            <p class="small">Agent: @(machine.AgentHealthy ? "saudável" : "indisponível ou não validado") · Política: v@machine.PolicyVersion</p>
            <a asp-action="Index" asp-route-editId="@machine.Id" class="btn btn-outline-light btn-sm mb-3" title="Carrega os dados desta máquina no formulário acima para edição.">Editar cadastro</a>

            <form asp-action="StartPairing" method="post" class="mb-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="machineId" value="@machine.Id" />
                <button type="submit" class="btn btn-accent btn-sm" title="Gera um código temporário de 6 dígitos para parear esta máquina CLIENTE.">INICIAR CONFIGURAÇÃO</button>
            </form>

            <form asp-action="Revoke" method="post" class="mb-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="machineId" value="@machine.Id" />
                <button type="submit" class="btn btn-outline-danger btn-sm" title="Invalida a credencial desta estação; será necessário parear novamente." onclick="return confirm('Revogar a credencial desta estação?');">Revogar credencial</button>
            </form>

            <div class="button-row">
                @foreach (var commandType in new[] { RemoteCommandType.LockScreen, RemoteCommandType.UnlockStation, RemoteCommandType.RestartStation, RemoteCommandType.ShutdownStation, RemoteCommandType.LogoffStation, RemoteCommandType.EnterMaintenance, RemoteCommandType.ExitMaintenance, RemoteCommandType.ToggleTimerVisibility })
                {
                    <form asp-action="Command" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MachineId" value="@machine.Id" />
                        <input type="hidden" name="Type" value="@commandType" />
                        <input type="hidden" name="Title" value="@commandType" />
                        <input type="hidden" name="Message" value="Comando enviado pelo administrador." />
                        @if (commandType is RemoteCommandType.RestartStation or RemoteCommandType.ShutdownStation or RemoteCommandType.LogoffStation)
                        {
                            <button class="btn btn-outline-light btn-sm" onclick="return confirm('Confirma esta ação?');">@commandType</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-light btn-sm">@commandType</button>
                        }
                    </form>
                }
            </div>

            <form asp-action="Command" method="post" class="form-grid">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MachineId" value="@machine.Id" />
                <input type="hidden" name="Type" value="@RemoteCommandType.ShowMessage" />
                <input type="hidden" name="Title" value="Aviso do administrador" />
                <div>
                    <label class="form-label">Mensagem personalizada</label>
                    <input name="Message" class="form-control" maxlength="500" required placeholder="Digite um aviso claro para essa máquina" />
                </div>
                <button class="btn btn-accent">Enviar aviso</button>
            </form>

        </article>
    }
</section>
