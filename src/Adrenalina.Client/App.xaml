<Application x:Class="Adrenalina.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Foreground" Value="#F7FAFF" />
            <Setter Property="Background" Value="#263653" />
            <Setter Property="BorderBrush" Value="#3B4B6B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33486E" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="#F7FAFF" />
            <Setter Property="CaretBrush" Value="#F7FAFF" />
            <Setter Property="Background" Value="#0C1526" />
            <Setter Property="BorderBrush" Value="#354565" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="#F7FAFF" />
            <Setter Property="Background" Value="#0C1526" />
            <Setter Property="BorderBrush" Value="#354565" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Foreground" Value="#F7FAFF" />
            <Setter Property="Background" Value="#0C1526" />
            <Setter Property="BorderBrush" Value="#354565" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEF2FF" />
        </Style>
    </Application.Resources>
</Application>
