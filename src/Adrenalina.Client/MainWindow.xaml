<Window x:Class="Adrenalina.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adrenalina Client"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        Background="#0B1020"
        Foreground="#EEF2FF">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#09111E" Offset="0" />
                <GradientStop Color="#131D33" Offset="0.52" />
                <GradientStop Color="#0D1424" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="MachineTitleText" FontSize="28" FontWeight="Bold" Text="ADRENALINA CLIENT" />
                    <TextBlock x:Name="SessionStatusText" Margin="0,8,0,0" Foreground="#B3C2D9" Text="Carregando estado local..." />
                    <TextBlock x:Name="ConnectivityText" Margin="0,6,0,0" Foreground="#7FD9C7" Text="Conexão aguardando a primeira sincronização." />
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="SettingsButton"
                            Margin="0,0,10,0"
                            Padding="14,10"
                            Content="Configurações"
                            Click="SettingsButton_Click" />
                    <Button x:Name="TutorialButton"
                            Padding="14,10"
                            Content="Tutorial"
                            Click="TutorialButton_Click" />
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SessionCard"
                        Padding="22"
                        Margin="0,0,14,0"
                        Background="#141D32"
                        BorderBrush="#26314D"
                        BorderThickness="1"
                        CornerRadius="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Sessão atual" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentUserText" Grid.Row="1" Margin="0,16,0,0" FontSize="18" Text="Usuário: aguardando login" />
                        <TextBlock x:Name="ProfileText" Grid.Row="2" Margin="0,6,0,0" Foreground="#B3C2D9" Text="Perfil: bloqueado" />

                        <WrapPanel Grid.Row="3" Margin="0,20,0,0">
                            <Border Padding="16" Margin="0,0,12,0" CornerRadius="18" Background="#1D2944">
                                <StackPanel>
                                    <TextBlock Text="Tempo" Foreground="#B3C2D9" />
                                    <TextBlock x:Name="RemainingTimeText" FontSize="24" FontWeight="Bold" Text="--" />
                                </StackPanel>
                            </Border>
                            <Border Padding="16" Margin="0,0,12,0" CornerRadius="18" Background="#1D2944">
                                <StackPanel>
                                    <TextBlock Text="Saldo" Foreground="#B3C2D9" />
                                    <TextBlock x:Name="BalanceText" FontSize="24" FontWeight="Bold" Text="R$ 0,00" />
                                </StackPanel>
                            </Border>
                            <Border Padding="16" CornerRadius="18" Background="#1D2944">
                                <StackPanel>
                                    <TextBlock Text="Anotado" Foreground="#B3C2D9" />
                                    <TextBlock x:Name="AnnotationText" FontSize="24" FontWeight="Bold" Text="R$ 0,00" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border Grid.Row="4"
                                Margin="0,24,0,0"
                                Padding="18"
                                CornerRadius="18"
                                Background="#1A2338"
                                BorderBrush="#2B3652"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Observações da conta" FontWeight="SemiBold" />
                                <TextBlock x:Name="NotesText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#B3C2D9" Text="Sem observações." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="LoginCard"
                        Grid.Column="1"
                        Padding="22"
                        Background="#141D32"
                        BorderBrush="#26314D"
                        BorderThickness="1"
                        CornerRadius="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Entrar na máquina" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,18"
                                       Foreground="#B3C2D9"
                                       Text="Preencha usuário e PIN para entrar. Solicitações adicionais ficam logo abaixo."
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Usuário" />
                            <TextBox x:Name="LoginTextBox" Margin="0,6,0,12" Padding="10" />
                            <TextBlock Margin="0,-8,0,12"
                                       Foreground="#8FB2D8"
                                       Text="Use letras e, se quiser, números, ponto, hífen ou sublinhado. Não use espaços."
                                       TextWrapping="Wrap" />

                            <TextBlock Text="PIN de 4 dígitos" />
                            <PasswordBox x:Name="PinBox" Margin="0,6,0,18" Padding="10" />

                            <Button x:Name="LoginButton" Content="Entrar" Margin="0,0,0,14" Padding="14,10" Click="LoginButton_Click" />

                            <Expander Header="Outras opções" IsExpanded="False">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Foreground="#B3C2D9"
                                               Text="Use estas opções quando precisar de ajuda do atendimento."
                                               TextWrapping="Wrap" />

                                    <TextBlock Margin="0,14,0,0" Text="Nome para cadastro" />
                                    <TextBox x:Name="DisplayNameTextBox" Margin="0,6,0,12" Padding="10" />

                                    <TextBlock Text="Mensagem para o atendimento" />
                                    <TextBox x:Name="MessageTextBox"
                                             Margin="0,6,0,12"
                                             Height="88"
                                             Padding="10"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True" />

                                    <TextBlock Text="Minutos adicionais desejados" />
                                    <TextBox x:Name="RequestMinutesTextBox" Margin="0,6,0,12" Padding="10" Text="30" />

                                    <Button Content="Solicitar cadastro" Margin="0,0,0,10" Padding="14,10" Click="RequestRegistration_Click" />
                                    <Button Content="Pedir mais tempo" Margin="0,0,0,10" Padding="14,10" Click="RequestMoreTime_Click" />
                                    <Button x:Name="ToggleTimerButton" Content="Ocultar/exibir tempo" Padding="14,10" Click="ToggleTimer_Click" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Padding="18"
                    Background="#141D32"
                    BorderBrush="#26314D"
                    BorderThickness="1"
                    CornerRadius="24">
                <StackPanel>
                    <TextBlock Text="Avisos recentes" FontSize="18" FontWeight="SemiBold" />
                    <ListBox x:Name="NotificationsList"
                             Margin="0,12,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#EEF2FF" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="SetupOverlay" Background="#D9111720" Visibility="Collapsed">
            <Grid>
                <Border Width="620"
                        MaxHeight="760"
                        Padding="28"
                        Background="#111A2D"
                        BorderBrush="#31405E"
                        BorderThickness="1"
                        CornerRadius="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Preparar cliente" FontSize="28" FontWeight="Bold" />
                            <TextBlock Margin="0,10,0,24"
                                       Foreground="#B3C2D9"
                                       Text="Informe os dados cadastrados pelo administrador e valide a conexão antes de salvar."
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Servidor do ADMIN" ToolTip="Endereço mostrado no ADMIN. Na instalação padrão ele começa com https://, por exemplo https://192.168.0.10:5076/." />
                            <TextBox x:Name="SetupServerUrlTextBox" Margin="0,6,0,14" Padding="10" ToolTip="Digite o endereço do ADMIN. O ADMIN precisa estar ligado e acessível na rede." />
                            <TextBlock Margin="0,-8,0,14"
                                       Foreground="#8FB2D8"
                                       Text="Copie o endereço mostrado no app ADMIN. Na instalação padrão: https://192.168.0.10:5076/"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,-8,0,6" Foreground="#8FB2D8" Text="Se o teste avisar sobre certificado, copie o arquivo .cer da pasta C:\ProgramData\Adrenalina\certs do ADMIN e use o botão abaixo." TextWrapping="Wrap" />
                            <Button Content="INSTALAR CERTIFICADO DO ADMIN..." Padding="12,8" Margin="0,0,0,14" Click="InstallAdminCertificateButton_Click" ToolTip="Instala o arquivo .cer criado pelo seu ADMIN para que esta estação reconheça a conexão HTTPS segura." />

                            <TextBlock Text="Nome desta máquina" ToolTip="Nome usado pelo ADMIN para identificar este computador." />
                            <TextBox x:Name="SetupMachineNameTextBox" Margin="0,6,0,14" Padding="10" ToolTip="Use um nome fácil de reconhecer, como PC-01." />

                            <TextBlock Text="Chave manual da máquina (opcional)" ToolTip="Chave antiga de compatibilidade. No pareamento novo, a credencial segura é criada automaticamente." />
                            <TextBox x:Name="SetupMachineKeyTextBox" Margin="0,6,0,4" Padding="10" ToolTip="Deixe vazio quando usar o código de pareamento. Se usar a configuração manual, informe uma chave única de 16 a 100 caracteres." />
                            <TextBlock Margin="0,0,0,14" Foreground="#8FB2D8" Text="Se você vai usar o código de 6 dígitos, não precisa preencher esta chave." TextWrapping="Wrap" />

                            <Border Margin="0,8,0,18" Padding="16" Background="#18233B" BorderBrush="#2F3D5C" BorderThickness="1" CornerRadius="16">
                                <StackPanel>
                                    <TextBlock Text="Configuração segura da estação" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,12" Foreground="#B3C2D9" Text="Prefira o código temporário exibido no ADMIN. A credencial será protegida pelo Windows e nunca será salva em texto puro." TextWrapping="Wrap" />
                                     <TextBlock Text="Código temporário do ADMIN" ToolTip="Código de 6 dígitos gerado no ADMIN em Máquinas > INICIAR CONFIGURAÇÃO." />
                                     <TextBox x:Name="PairingCodeTextBox" Margin="0,6,0,10" Padding="10" MaxLength="6" ToolTip="Cole aqui os 6 números mostrados no ADMIN." />
                                     <Button x:Name="PairingButton" Content="PAREAR CONFIGURAÇÃO" Padding="16,12" Click="PairingButton_Click" ToolTip="Envia o código ao ADMIN. Após sua aprovação, o Client verifica automaticamente e conclui a configuração." />
                                    <TextBlock x:Name="PairingStatusText" Margin="0,10,0,0" Foreground="#7FD9C7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Button Content="Salvar e iniciar cliente"
                                    Padding="16,12"
                                    Margin="0,0,0,12"
                                    Click="SaveSetupButton_Click"
                                    ToolTip="Salva o endereço e a configuração manual. Para o fluxo recomendado, use o código temporário acima." />
                            <Button Content="Testar conexão"
                                    Padding="16,12"
                                    Margin="0,0,0,12"
                                    Click="TestSetupConnectionButton_Click"
                                    ToolTip="Verifica se o CLIENTE consegue alcançar o ADMIN." />
                            <Button Content="Fechar"
                                    Padding="16,12"
                                    Click="CloseSetupButton_Click"
                                    ToolTip="Fecha esta tela sem alterar a configuração atual." />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="SettingsOverlay" Background="#D9111720" Visibility="Collapsed">
            <Grid>
                <Border Width="660"
                        MaxHeight="780"
                        Padding="28"
                        Background="#111A2D"
                        BorderBrush="#31405E"
                        BorderThickness="1"
                        CornerRadius="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Configurações da máquina" FontSize="28" FontWeight="Bold" />
                            <TextBlock Margin="0,10,0,24"
                                       Foreground="#B3C2D9"
                                       Text="Estas configurações ficam salvas somente neste Client."
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Servidor do ADMIN" />
                            <TextBox x:Name="SettingsServerUrlTextBox" Margin="0,6,0,14" Padding="10" />
                            <TextBlock Margin="0,-8,0,14"
                                       Foreground="#8FB2D8"
                                       Text="Este endereço deve apontar para o computador do administrador."
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Nome desta máquina" />
                            <TextBox x:Name="SettingsMachineNameTextBox" Margin="0,6,0,14" Padding="10" />

                            <TextBlock Text="Chave da máquina" />
                            <TextBox x:Name="SettingsMachineKeyTextBox" Margin="0,6,0,14" Padding="10" />

                            <TextBlock Text="Intervalo de sincronização (segundos)" />
                            <TextBox x:Name="SettingsSyncIntervalTextBox" Margin="0,6,0,18" Padding="10" />

                            <CheckBox x:Name="RepeatTutorialCheckBox"
                                      Margin="0,0,0,24"
                                      Content="Mostrar o tutorial novamente na próxima abertura" />

                            <WrapPanel>
                                <Button Content="Salvar configurações"
                                        Margin="0,0,10,10"
                                        Padding="16,12"
                                        Click="SaveSettingsButton_Click" />
                                <Button Content="Abrir tutorial agora"
                                        Margin="0,0,10,10"
                                        Padding="16,12"
                                        Click="OpenTutorialFromSettingsButton_Click" />
                                <Button Content="Testar conexão"
                                        Margin="0,0,10,10"
                                        Padding="16,12"
                                        Click="TestSettingsConnectionButton_Click" />
                                <Button Content="Fechar"
                                        Margin="0,0,0,10"
                                        Padding="16,12"
                                        Click="CloseSettingsButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="TutorialOverlay" Background="#D9111720" Visibility="Collapsed">
            <Grid>
                <Border Width="720"
                        MaxHeight="780"
                        Padding="28"
                        Background="#111A2D"
                        BorderBrush="#31405E"
                        BorderThickness="1"
                        CornerRadius="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Tutorial do cliente" FontSize="28" FontWeight="Bold" />
                            <TextBlock Margin="0,10,0,24"
                                       Foreground="#B3C2D9"
                                       Text="Um guia curto para entender a conexão, o login e as solicitações. Você pode pular ou reabrir quando quiser."
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TutorialProgressText" Foreground="#7FD9C7" FontWeight="SemiBold" />
                                <TextBlock x:Name="TutorialStepNumberText" Grid.Column="1" Foreground="#B3C2D9" />
                            </Grid>

                            <Border Padding="22" Background="#18233B" CornerRadius="18" BorderBrush="#2F3D5C" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock x:Name="TutorialStepTitleText" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TutorialStepBodyText" Margin="0,12,0,0" Foreground="#B3C2D9" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,24,0,0" HorizontalAlignment="Right">
                                <Button x:Name="TutorialBackButton" Content="Voltar" Margin="0,0,10,10" Padding="16,12" Click="TutorialBackButton_Click" />
                                <Button x:Name="TutorialSkipButton" Content="Pular" Margin="0,0,10,10" Padding="16,12" Click="TutorialSkipButton_Click" />
                                <Button x:Name="TutorialNextButton" Content="Próximo" Margin="0,0,10,10" Padding="16,12" Click="TutorialNextButton_Click" />
                                <Button x:Name="TutorialFinishButton" Content="Concluir" Padding="16,12" Click="CloseTutorialButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
